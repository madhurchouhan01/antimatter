# .env.example — copy to .env and fill in

# --- Database & Redis (Docker Compose defaults) ---
DATABASE_URL=postgresql+asyncpg://aicoder:aicoder@postgres:5432/aicoder
REDIS_URL=redis://redis:6379

# --- Database & Redis (Local run defaults) ---
# DATABASE_URL=postgresql+asyncpg://aicoder:aicoder@localhost:5432/aicoder
# REDIS_URL=redis://localhost:6379

# --- Security & Auth ---
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1500
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- GitHub OAuth App (Required for login) ---
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --- Workspace & Sandbox configuration ---
WORKSPACE_ROOT=/workspaces
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Primary LLM Provider (Groq) ---
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional LLM Providers ---
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=AIzaSyYourGeminiKeyHere
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
VOYAGE_API_KEY=your-voyage-key-here

# --- Ollama (Local / Self-hosted LLMs — no API key required) ---
# Point this to your Ollama instance. Defaults to localhost if unset.
# For remote Ollama: http://<your-machine-ip>:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# --- LangSmith Tracing & Observability (Optional) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_your_langsmith_key_here
LANGSMITH_PROJECT=Antimatter